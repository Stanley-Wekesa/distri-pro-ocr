# Set a long random secret in the hosting dashboard. Never commit the real key.
OCR_API_KEY=replace-with-a-long-random-secret

# Temporary upload limit: 12 MB
MAX_UPLOAD_BYTES=12000000

# Generic starter pattern. We will refine this after testing actual delivery notes.
SERIAL_REGEX=(?i)\b[A-Z0-9]{2,}(?:[/-][A-Z0-9]{1,}){1,5}\b
