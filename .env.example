# Generate both secrets with: openssl rand -hex 32
OCR_API_KEY=replace-with-a-long-random-secret
OCR_CALLBACK_SECRET=replace-with-a-different-long-random-secret

# Comma-separated exact HTTPS hostnames. Do not include schemes or paths.
# Example: private-storage.example.com
FILE_URL_ALLOWED_HOSTS=your-private-storage-host.example.com

# Exact hostname(s) allowed to receive callbacks.
# Example: app.booklystpress.com
CALLBACK_ALLOWED_HOSTS=your-distripro-host.example.com

# Persistent data directory inside the container
DATA_DIR=/var/data

# Document limits
MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=1000

# Sequential processing controls
PAGES_PER_CHUNK=10
MAX_CHUNK_SIZE=20
CHUNK_RETRIES=2
WORKER_POLL_SECONDS=2
CALLBACK_POLL_SECONDS=3

# OCR and network tuning
PDF_RENDER_SCALE=2.0
DOWNLOAD_TIMEOUT_SECONDS=180
CALLBACK_TIMEOUT_SECONDS=20

# Preserve the tested Booklyst-style serial format, including a space before digits.
SERIAL_REGEX=(?i)\b[A-Z0-9]{2,}(?:[/-][A-Z0-9]{1,}){1,5}(?:\s+\d+)?\b
LOG_LEVEL=INFO
